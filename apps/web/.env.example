# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Closed-beta access gate (middleware cookie).
# Local/preview: unset = no gate. Production: defaults to 1996 if unset.
# Override on Vercel with GODMODEPROD_ACCESS_CODE if you want a different code.
GODMODEPROD_ACCESS_CODE=

# Telegram bot (docket capture via @BotFather bot)
# TELEGRAM_BOT_TOKEN — token from /newbot
# TELEGRAM_WEBHOOK_SECRET — random string; passed to setWebhook as `secret_token`
# TELEGRAM_ALLOWED_CHATS — comma-separated list of chat IDs allowed to post /docket
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHATS=
